<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <!-- Link to your compiled Tailwind CSS or include CDN -->
    <!-- For local dev, you might need to set up Tailwind CSS -->
    <!-- <link href="/css/styles.css" rel="stylesheet"> -->
    <style>
        /* Basic dark mode and Tailwind-like styling for demonstration */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1a202c; /* Dark background */
            color: #e2e8f0; /* Light text */
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
            background-color: #2d3748; /* Slightly lighter dark background */
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }
        h1, h2, h3 {
            color: #4299e1; /* Primary accent color */
            margin-bottom: 15px;
        }
        h1 { font-size: 2.5rem; }
        h2 { font-size: 2rem; margin-top: 30px; }
        h3 { font-size: 1.5rem; margin-top: 20px; }
        a { color: #4299e1; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .section { margin-bottom: 30px; padding: 20px; background-color: #2d3748; border-radius: 8px; border: 1px solid #4a5568;}
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 8px; font-weight: bold; color: #a0aec0; }
        input[type="text"],
        input[type="number"],
        select,
        textarea {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #4a5568;
            border-radius: 4px;
            background-color: #1a202c; /* Dark input background */
            color: #e2e8f0;
            box-sizing: border-box;
        }
        textarea { min-height: 100px; resize: vertical; }
        button {
            padding: 10px 20px;
            background-color: #4299e1;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            transition: background-color 0.2s ease;
        }
        button:hover { background-color: #2774a4; }
        .button-secondary { background-color: #6b7280; }
        .button-secondary:hover { background-color: #4b5563; }
        .button-danger { background-color: #ef4444; }
        .button-danger:hover { background-color: #dc2626; }
        .alert { padding: 15px; margin-bottom: 20px; border-radius: 4px; }
        .alert-danger { background-color: #f87171; color: #7f1d1d; border: 1px solid #dc2626;}
        .alert-success { background-color: #34d391; color: #064e3b; border: 1px solid #10b981;}
        .log-list { max-height: 400px; overflow-y: auto; background-color: #1a202c; border: 1px solid #4a5568; border-radius: 4px; padding: 10px; }
        .log-item { padding: 8px 0; border-bottom: 1px solid #4a5568; font-size: 0.9rem; }
        .log-item:last-child { border-bottom: none; }
        .log-item.success { color: #34d391; }
        .log-item.failed { color: #f87171; }
        .log-item strong { color: #a0aec0; }
        .config-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .blog-selector label { margin-bottom: 0; }
        .blog-selector select { width: auto; margin-left: 10px; }
        .blog-selector { display: flex; align-items: center; margin-bottom: 20px;}
        .api-status { font-style: italic; font-size: 0.85rem; color: #718096;}
        .api-status.ok { color: #34d391; }
        .api-status.warn { color: #fbb344; }
        .api-status.error { color: #f87171; }
        .actions { margin-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Blogger Autonomous AI Powerhouse</h1>
        <p>Admin Dashboard</p>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert <%= error ? 'alert-danger' : 'alert-success' %>">
                <%= message %>
            </div>
        <% } %>

        <div class="section">
            <h2>Google Authentication & Blog Selection</h2>
            <p>Status: <span class="api-status <%= (settings.selectedBlogId && selectedBlogDetails) ? 'ok' : 'warn' %>"><%= (settings.selectedBlogId && selectedBlogDetails) ? 'Connected to: ' + selectedBlogDetails.name : 'Not Connected' %></span></p>
            <form action="/auth/login" method="GET" style="display: inline-block;">
                <button type="submit" class="button-secondary">Connect/Re-authenticate Google Account</button>
            </form>
            <% if (blogs && blogs.length > 0) { %>
                <form action="/auth/resync-blogs" method="POST" style="display: inline-block; margin-left: 15px;">
                    <button type="submit" class="button-secondary">Resync Blogs</button>
                </form>
            <% } %>
        </div>

        <% if (blogs && blogs.length > 0) { %>
            <div class="section">
                <h2>Target Blog Configuration</h2>
                <form action="/admin/save-settings" method="POST" class="blog-selector">
                    <label for="blogId">Select Target Blog:</label>
                    <select id="blogId" name="selectedBlogId">
                        <option value="">-- None --</option>
                        <% blogs.forEach(function(blog) { %>
                            <option value="<%= blog.id %>" <%= settings.selectedBlogId === blog.id ? 'selected' : '' %>><%= blog.name %> (<%= blog.url ? blog.url.replace(/^https?:\/\//, '').split('/')[0] : 'no url' %>)</option>
                        <% }); %>
                    </select>
                    <input type="hidden" name="_method" value="PUT"> <!-- For method-override -->
                    <button type="submit" class="button-secondary" style="margin-left: 15px;">Save Blog Selection</button>
                </form>
            </div>
        <% } else { %>
            <div class="section alert alert-danger">
                Google account is connected, but no blogs were found. Please ensure you have blogs set up and try re-syncing.
            </div>
        <% } %>

        <div class="section">
            <h2>Content Generation Settings</h2>
            <form action="/admin/save-settings" method="POST">
                <input type="hidden" name="_method" value="PUT">
                <div class="config-grid">
                    <div class="form-group">
                        <label for="category">Category/Topic:</label>
                        <input type="text" id="category" name="category" value="<%= settings.category %>" placeholder="e.g., Technology, AI, Travel">
                    </div>
                    <div class="form-group">
                        <label for="frequencyHours">Publishing Frequency (Hours):</label>
                        <input type="number" id="frequencyHours" name="frequencyHours" value="<%= settings.frequencyHours %>" min="1" placeholder="e.g., 24">
                    </div>
                    <div class="form-group">
                        <label for="postLength">Post Length:</label>
                        <select id="postLength" name="postLength">
                            <option value="short" <%= settings.postLength === 'short' ? 'selected' : '' %>>Short (~300 words)</option>
                            <option value="medium" <%= settings.postLength === 'medium' ? 'selected' : '' %>>Medium (~600 words)</option>
                            <option value="long" <%= settings.postLength === 'long' ? 'selected' : '' %>>Long (~1200+ words)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="language">Language:</label>
                        <select id="language" name="language">
                            <option value="English" <%= settings.language === 'English' ? 'selected' : '' %>>English</option>
                            <option value="Bangla" <%= settings.language === 'Bangla' ? 'selected' : '' %>>Bangla</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="writingTone">Writing Tone:</label>
                        <select id="writingTone" name="writingTone">
                            <option value="Professional" <%= settings.writingTone === 'Professional' ? 'selected' : '' %>>Professional</option>
                            <option value="Casual" <%= settings.writingTone === 'Casual' ? 'selected' : '' %>>Casual</option>
                            <option value="Storytelling" <%= settings.writingTone === 'Storytelling' ? 'selected' : '' %>>Storytelling</option>
                            <option value="Medical/Academic" <%= settings.writingTone === 'Medical/Academic' ? 'selected' : '' %>>Medical/Academic</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="publishingMode">Publishing Mode:</label>
                        <select id="publishingMode" name="publishingMode">
                            <option value="Direct" <%= settings.publishingMode === 'Direct' ? 'selected' : '' %>>Direct Publish</option>
                            <option value="Draft" <%= settings.publishingMode === 'Draft' ? 'selected' : '' %>>Save as Draft</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="seoKeywords">SEO Keywords (comma-separated):</label>
                        <input type="text" id="seoKeywords" name="seoKeywords" value="<%= (settings.seoKeywords || []).join(', ') %>" placeholder="AI, Machine Learning, future of tech">
                    </div>
                    <div class="form-group">
                        <label for="ppcTargetLinks">PPC Target Links (one per line):</label>
                        <textarea id="ppcTargetLinks" name="ppcTargetLinks" placeholder="https://example.com/offer1\nhttps://example.com/offer2"><%= (settings.ppcTargetLinks || []).join('\n') %></textarea>
                    </div>
                    <div class="form-group">
                        <label for="preferredAiProvider">Preferred AI Provider:</label>
                        <select id="preferredAiProvider" name="preferredAiProvider">
                            <option value="grok" <%= settings.preferredAiProvider === 'grok' ? 'selected' : '' %>>Grok (Default)</option>
                            <option value="gemini" <%= settings.preferredAiProvider === 'gemini' ? 'selected' : '' %>>Gemini</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="autoRotateKeys">
                            <input type="checkbox" id="autoRotateKeys" name="autoRotateKeys" <%= settings.autoRotateKeys ? 'checked' : '' %>>
                            Auto-rotate / Fallback to alternate provider on failure
                        </label>
                    </div>
                </div>
                <button type="submit">Save Settings</button>
            </form>
        </div>

        <div class="section">
            <h2>Pipeline Control</h2>
            <p>
                The autonomous pipeline is designed to be triggered by an external cron job hitting the `/api/trigger-autopost` endpoint.
            </p>
            <form action="/admin/trigger-pipeline" method="POST" style="display: inline-block;">
                <button type="submit" class="button-secondary">Run Pipeline Test Now</button>
            </form>
            <p><small>This will run the content generation process once immediately.</small></p>
            <p class="api-status <%= apiConfig.grok.apiKey && apiConfig.image.unsplashApiKey && apiConfig.telegram.botToken && apiConfig.telegram.chatId ? 'ok' : 'warn' %>">
                API Key Status: <%= apiConfig.grok.apiKey ? 'Grok OK' : 'Grok MISSING' %> |
                <%= apiConfig.image.unsplashApiKey ? 'Image API OK' : 'Image API MISSING' %> |
                <%= apiConfig.telegram.botToken && apiConfig.telegram.chatId ? 'Telegram OK' : 'Telegram MISSING' %>
            </p>
        </div>

        <!-- API Key Management Section -->
        <div class="section">
            <h2>API Key Management</h2>
            <p>Manage your Grok and Gemini API keys. The system rotates keys automatically &mdash; least-used active keys are preferred.</p>
            <p><strong>Active Keys:</strong> Grok: <%= keyCounts.grok %> | Gemini: <%= keyCounts.gemini %></p>

            <!-- Add Key Form -->
            <h3>Add New API Key</h3>
            <form action="/api-keys/add" method="POST" style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 120px;">
                    <label for="addProvider">Provider</label>
                    <select id="addProvider" name="provider" required>
                        <option value="grok">Grok</option>
                        <option value="gemini">Gemini</option>
                    </select>
                </div>
                <div style="flex: 3; min-width: 200px;">
                    <label for="addKey">API Key</label>
                    <input type="text" id="addKey" name="key" placeholder="Paste your API key here" required>
                </div>
                <div style="flex: 2; min-width: 150px;">
                    <label for="addLabel">Label (optional)</label>
                    <input type="text" id="addLabel" name="label" placeholder="e.g., Production Key 1">
                </div>
                <div>
                    <button type="submit" class="button-secondary" style="margin-top: 10px;">Add Key</button>
                </div>
            </form>

            <!-- Existing Keys List -->
            <h3 style="margin-top: 25px;">Stored API Keys</h3>
            <% if (apiKeys && apiKeys.length > 0) { %>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                        <thead>
                            <tr style="border-bottom: 2px solid #4a5568; text-align: left;">
                                <th style="padding: 8px;">Provider</th>
                                <th style="padding: 8px;">Label</th>
                                <th style="padding: 8px;">Key (masked)</th>
                                <th style="padding: 8px;">Status</th>
                                <th style="padding: 8px;">Usage</th>
                                <th style="padding: 8px;">Last Used</th>
                                <th style="padding: 8px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% apiKeys.forEach(function(k) { %>
                                <tr style="border-bottom: 1px solid #4a5568;">
                                    <td style="padding: 8px; text-transform: capitalize;"><%= k.provider %></td>
                                    <td style="padding: 8px;"><%= k.label %></td>
                                    <td style="padding: 8px; font-family: monospace;">
                                        <%= k.key.length > 12 ? k.key.substring(0, 8) + '...' + k.key.substring(k.key.length - 4) : '********' %>
                                    </td>
                                    <td style="padding: 8px;">
                                        <span style="color: <%= k.isActive ? '#34d391' : '#f87171' %>;">
                                            <%= k.isActive ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td style="padding: 8px;"><%= k.usageCount || 0 %> calls</td>
                                    <td style="padding: 8px;"><%= k.lastUsed ? new Date(k.lastUsed).toLocaleString() : 'Never' %></td>
                                    <td style="padding: 8px;">
                                        <form action="/api-keys/toggle/<%= k._id %>" method="POST" style="display: inline;">
                                            <button type="submit" class="button-secondary" style="padding: 4px 10px; font-size: 0.8rem;">
                                                <%= k.isActive ? 'Deactivate' : 'Activate' %>
                                            </button>
                                        </form>
                                        <form action="/api-keys/remove/<%= k._id %>" method="POST" style="display: inline; margin-left: 5px;" onsubmit="return confirm('Remove this key?');">
                                            <button type="submit" class="button-danger" style="padding: 4px 10px; font-size: 0.8rem;">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p style="color: #fbb344;">No API keys stored yet. Add your Grok and/or Gemini keys above.</p>
            <% } %>
        </div>

        <div class="section">
            <h2>Execution Logs</h2>
            <div class="log-list">
                <% if (executionLogs && executionLogs.length > 0) { %>
                    <% executionLogs.forEach(function(log) { %>
                        <div class="log-item <%= log.status.toLowerCase() %>">
                            <strong>[<%= new Date(log.timestamp).toLocaleString() %>]</strong> [<%= log.status %>] <strong><%= log.action %></strong>:
                            <% if (log.status === 'SUCCESS') { %>
                                <% if (log.blogPostUrl) { %>
                                    <a href="<%= log.blogPostUrl %>" target="_blank"><%= log.blogPostUrl %></a>
                                <% } else if (log.details && log.details.postId) { %>
                                     Post ID: <%= log.details.postId %>
                                <% } else if (log.details) { %>
                                    <% try { %>
                                        <%= JSON.stringify(log.details).substring(0, 100) + (JSON.stringify(log.details).length > 100 ? '...' : '') %>
                                    <% } catch (e) { %>
                                        [Details too large to display]
                                    <% } %>
                                <% } %>
                            <% } else { %>
                                <%= log.errorMessage %>
                            <% } %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No execution logs found yet.</p>
                <% } %>
            </div>
        </div>

    </div>
</body>
</html>