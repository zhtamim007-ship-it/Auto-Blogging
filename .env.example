# --- Server ---
PORT=3000
NODE_ENV=production
# Set to true to disable the built-in hourly scheduler (e.g. when using an external cron)
DISABLE_SCHEDULER=false

# --- Database (required) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bloggerAI

# --- Google OAuth / Blogger ---
# You can set these as environment variables here OR use the in-app setup page
# at /auth/google-setup (no redeploy needed). In-app values take precedence.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Must exactly match a URI registered in Google Cloud Console → Credentials →
# Authorised redirect URIs. If left unset the app falls back to
# RENDER_EXTERNAL_URL + /auth/callback, then to the incoming request host —
# check the resolved value at /auth/status.
GOOGLE_CALLBACK_URL=https://your-app-name.onrender.com/auth/callback

# --- AI providers (keys can also be managed from the dashboard) ---
GROK_API_KEY=YOUR_GROK_API_KEY
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-2-latest
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# --- Images (Unsplash) ---
IMAGE_API_KEY=YOUR_UNSPLASH_ACCESS_KEY

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
